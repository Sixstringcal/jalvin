{
  "name": "jalvin",
  "version": "1.0.0",
  "description": "The Jalvin programming language — multi-platform, JS-interoperable",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "typecheck": "pnpm -r typecheck",
    "prepublish": "node scripts/validate-no-workspace-refs.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "playwright": "^1.59.1",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
