{
  "name": "@jalvin/cli",
  "version": "2.0.39",
  "description": "Jalvin language — command line interface",
  "type": "module",
  "bin": {
    "jalvin": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "publishConfig": { "access": "public" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && sed -i '' '1s/^/#!\\/usr\\/bin\\/env node\\n/' dist/cli.js && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@jalvin/compiler": "workspace:*",
    "vite": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  }
}
